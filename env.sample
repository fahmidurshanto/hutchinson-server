PORT=4000

MONGO_URI=mongodb://admin:your_secure_password@localhost:27017/myapp?authSource=admin

SALT_ROUNDS=10

JWT_SECRET=your_jwt_secret_key

# keep REFRESH_COOKIES_VALIDITY and REFRESH_TOKEN_VALIDITY same

REFRESH_TOKEN_VALIDITY=1d
ACCESS_TOKEN_VALIDITY=15m

REFRESH_COOKIES_VALIDITY=1  # In Days enter only number
ACCESS_COOKIES_VALIDITY=15  # In minutes enter only minutes 

NODE_ENV=development